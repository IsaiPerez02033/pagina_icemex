# Groq API key (gratuita en https://console.groq.com/keys)
GROQ_API_KEY=
# Modelo del chatbot (opcional). Groq retira modelos sin aviso: si el chat
# deja de responder, revisa https://console.groq.com/docs/models y cámbialo aquí.
# GROQ_MODEL=openai/gpt-oss-120b

# Upstash Redis: analytics propios, rate limit y leads de formularios
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NextAuth — Admin dashboard (NEXTAUTH_SECRET es obligatorio en producción)
NEXTAUTH_URL=https://icemex.mx
NEXTAUTH_SECRET=

# Admin credentials (cambiar en producción)
ADMIN_EMAIL=admin@icemex.mx
ADMIN_PASSWORD=

# Microsoft Clarity (heatmaps, grabaciones gratuitas)
# Crear proyecto en: https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console (OAuth) para /admin/seo
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# SEARCH_CONSOLE_SITE_URL=https://icemex.mx
