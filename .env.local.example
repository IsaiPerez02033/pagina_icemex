# Groq API key (gratuita en https://console.groq.com/keys)
GROQ_API_KEY=

# NextAuth — Admin dashboard
NEXTAUTH_URL=https://icemex.mx
NEXTAUTH_SECRET=

# Admin credentials (cambiar en producción)
ADMIN_EMAIL=admin@icemex.mx
ADMIN_PASSWORD=

# Vercel Analytics (para que el dashboard muestre datos reales)
# Crear token en: Vercel → Settings → Tokens
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# Microsoft Clarity (heatmaps, grabaciones gratuitas)
# Crear proyecto en: https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# Google APIs (service account)
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GA4_PROPERTY_ID=
# SEARCH_CONSOLE_SITE_URL=
